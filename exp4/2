#include<iostream>
using namespace std;

class Rectangle
{
float length,breadth;

public:
void accept();
void area();
};

void Rectangle::accept()
{
cout<<"Enter length and breadth: ";
cin>>length>>breadth;
}

void Rectangle::area()
{
cout<<"Area="<<length*breadth;
}

int main()
{
Rectangle r;
r.accept();
r.area();
return 0;
}
