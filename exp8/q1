//Create an array of five employee objects.
#include <iostream>
using namespace std;

class employee
{
    int id;
    char name[30];
    
    public:
    void accept()
    {
        cout<<"enter employee id";
        cin>>id;
        cout<<"enter name";
        cin>>name;
    }
    void display()
    {
        cout<<"employee id"<<id;
        cout<<"name:"<<name;
    }
};
int main()
{
    employee e[5];
    for (int i=0;i<5;i++)
    {
        e[i].accept();
    }
    cout<<"Employee details";
    for(int i=0;i<3;i++)
    {
        e[i].display();
    }
    return 0;
    
    
    
}
