//Write an inline function to find the maximum of two numbers.
#include <iostream>
using namespace std;

inline int max(int a,int b)
{
    if(a>b)
    return a;
    else
    return b;
}

int main()
{
    int num1,num2;
    cout<<"enter 1st number";
    cin>>num1;
    cout<<"enter 2nd number";
    cin>>num2;
    cout<<"the maximum number is"<<max(num1,num2);
    
    

    return 0;
}
