//Write a program to calculate the cube of a number using an inline function.
#include <iostream>
using namespace std;

inline int cube(int n)
{
    return n*n*n;
}

int main()
{
    int num;
    cout<<"enter a number";
    cin>>num;
    
    cout<<"the cube is"<<cube(num);
    
    

    return 0;
}
