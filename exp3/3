#include<iostream>
using namespace std;

class Employee
{
int id;
char name[30];
float salary;

public:
void accept()
{
cout<<"Enter employee id: ";
cin>>id;
cout<<"Enter employee name: ";
cin>>name;
cout<<"Enter salary: ";
cin>>salary;
}

void display()
{
cout<<"Employee ID="<<id<<endl;
cout<<"Employee Name="<<name<<endl;
cout<<"Salary="<<salary;
}
};

int main()
{
Employee e;
e.accept();
e.display();

return 0;
}
