//3. Write a program to demonstrate that static variables are shared among all objects.
#include <iostream>
using namespace std;

class demo
{
    private:
    static int count;
    
    
    public:
    void display()
    {
        count++;
        cout<<"count="<<count;
    }
    
};
int demo::count=0;

int main()
{
    demo obj1,obj2,obj3;
    
    obj1.display();
    obj2.display();
    obj3.display();
    return 0;
}
