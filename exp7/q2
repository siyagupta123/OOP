////Write a program using a static member function to display the total number of
//employees.
#include <iostream>
using namespace std;

class employee
{
    private:
    static int count;
    public:
    employee()
    {
        count++;
    }
    static void display()
    {
        cout<<"totoal employees:"<<count;
    }
};
int employee::count=0;

int main()
{
    employee e1;
    employee e2;
    employee e3;
    
    employee::display();
    return 0;
}
